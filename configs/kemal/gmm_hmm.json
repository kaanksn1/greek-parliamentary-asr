{
  "_comment": "MFCC + GMM-HMM grapheme baseline (greek_asr.models.gmm_hmm). CPU or GPU tensors; the train set is read fully into RAM as 39-dim MFCC (about 5.6 GB for the full HParl-only train). train_subset_hours=null uses the whole manifest; set it only from a measured budget. See docs/KEMAL_BASELINES.md.",
  "dev_manifest": "data/manifests/dev.jsonl",
  "dev_references": "data/manifests/references/dev.jsonl",
  "features": {
    "cmn": "utterance_mean",
    "deltas": true,
    "frame_length_ms": 25.0,
    "frame_shift_ms": 10.0,
    "num_ceps": 13,
    "num_mel_bins": 23,
    "sample_rate": 16000
  },
  "seed": 42,
  "train_manifest": "data/manifests/subsets/train_hparl_30.5h_seed42.jsonl",
  "train_references": "data/manifests/subsets/references/train_hparl_30.5h_seed42.jsonl",
  "train_subset_hours": null,
  "training": {
    "align_batch_cells": 20000000,
    "infeasible_policy": "exclude_and_report",
    "initial_self_loop": 0.5,
    "lm_order": 3,
    "max_excluded_fraction": 0.01,
    "max_gaussians_per_state": 16,
    "min_gaussian_occupancy": 20.0,
    "num_iterations": 25,
    "self_loop_bounds": [
      0.05,
      0.95
    ],
    "split_iterations": [
      2,
      4,
      6,
      8
    ],
    "states_per_unit": 3,
    "variance_floor_fraction": 0.01
  },
  "tuning": {
    "dev_utterances": 200,
    "insertion_penalties": [
      -10.0,
      0.0,
      10.0
    ],
    "lm_weights": [
      6.0,
      10.0,
      14.0
    ],
    "space_skip_logprob": 0.0
  }
}
